# === DATABASE ===
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecoconnect"

# === REDIS (BullMQ) ===
REDIS_URL="redis://localhost:6379"

# === AUTH ===
JWT_SECRET="CHANGE_ME_MINIMUM_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_MINIMUM_32_CHARS"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# === AI — Google Gemini ===
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# === EMAIL ===
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@ecoconnect.in"

# === SMS (Twilio) — set to mock=true for hackathon ===
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
SMS_MOCK="true"

# === MEDIA STORAGE ===
# local | cloudinary
STORAGE_BACKEND="local"
UPLOAD_DIR="./uploads"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# === SERVER ===
PORT="4000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# === IDENTITY VERIFICATION ===
# mock | real
IDENTITY_PROVIDER="mock"
IDENTITY_PROVIDER_URL=""
IDENTITY_PROVIDER_API_KEY=""

# === JURISDICTION ===
JURISDICTION_NAME="Bengaluru Municipal Ward 42"
JURISDICTION_LAT="12.9716"
JURISDICTION_LNG="77.5946"
JURISDICTION_RADIUS_KM="10"

# === FRONTEND ===
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
